# QNAP web API (the NAS admin UI), reached from the machine running this agent
QNAP_HOST=192.168.50.30
QNAP_PORT=8080
QNAP_SSL=0
QNAP_USER=admin
QNAP_PASSWORD=

# the torrent butler's web app and the shared secret from its .env (AGENT_TOKEN)
WEBAPP_URL=http://192.168.50.20:8765
AGENT_TOKEN=
AGENT_NAME=qnap
# a full report every INTERVAL_SECONDS; between reports, check in with the web
# app every CHECKIN_SECONDS so "Refresh now" is answered within that time
INTERVAL_SECONDS=300
CHECKIN_SECONDS=5
# timeouts: each QNAP API call / each call to the web app
QNAP_TIMEOUT_SECONDS=20
HTTP_TIMEOUT_SECONDS=30
