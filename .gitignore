.env
.venv/
__pycache__/
*.pyc
data/
# the Flutter web bundle IS committed so `git pull` deploys it to hosts without
# Flutter (the Ubuntu box); CanvasKit is loaded from Google's CDN, not shipped
webapp/build/*
!webapp/build/web/
webapp/build/web/canvaskit/
webapp/.dart_tool/
webapp/.flutter-plugins*
webapp/*.iml

# flutter-agent-suite: secrets and per-environment config (never commit)
.env
.env.*
!.env.example
env/*.json
!env/*.example.json
android/key.properties
*.jks
*.keystore
*.p12
*.p8
*.mobileprovision
