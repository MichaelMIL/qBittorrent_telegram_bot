# Telegram
BOT_TOKEN=123456:ABC-your-bot-token-from-botfather
# Comma-separated Telegram user IDs allowed to use the bot
ALLOWED_USER_IDS=123456789

# qBittorrent Web UI (enable it in qBittorrent: Preferences -> Web UI)
QBIT_HOST=192.168.1.50
QBIT_PORT=8080
QBIT_USERNAME=admin
QBIT_PASSWORD=adminadmin

# HeBits search (optional). Log in to hebits.net in a browser, open DevTools ->
# Network tab, click any request to hebits.net, and copy the whole "Cookie"
# request header value here.
HEBITS_COOKIE=

# Plex (optional) — lets /plex trigger library scans.
# Easiest: leave PLEX_TOKEN empty and allow the bot's IP in Plex instead:
# Settings -> Network -> "List of IP addresses and networks that are allowed
# without auth" (e.g. 127.0.0.1 when the bot runs on the Plex machine).
# Or set a permanent token — on the Mac running Plex:
#   defaults read com.plexapp.plexmediaserver PlexOnlineToken
PLEX_URL=http://localhost:32400
PLEX_TOKEN=

# Web app (Flutter, served at http://<this-machine>:8765). bot.py serves it
# alongside Telegram; `python web.py` serves it without Telegram.
WEB_ENABLED=1
WEB_HOST=0.0.0.0
WEB_PORT=8765
# Two logins, one password field: the admin sees and can do everything; the
# user only gets the pages the admin enables in Settings (default: New,
# Search, adding). Without ADMIN_PASSWORD there is no login at all — anyone on
# your network can control qBittorrent. (WEB_PASSWORD is the old name.)
ADMIN_PASSWORD=
USER_PASSWORD=
# Extra password for the web app's Settings tab (interval tunables, Plex map,
# HeBits cookie, cache). Empty = settings open to anyone who is logged in.
SETTINGS_PASSWORD=
# Poster cache (data/covers): posters are re-encoded as small JPEGs, kept up to
# CACHE_MAX_MB (oldest evicted first) and wiped every CACHE_CLEAR_HOURS (0 = never)
CACHE_CLEAR_HOURS=168
CACHE_MAX_MB=1024
